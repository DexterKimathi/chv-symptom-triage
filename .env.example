# Copy to .env and fill in. Never commit .env. Every value has a working default, so the
# backend also runs with no .env at all, on a local SQLite file.

# Leave unset for local SQLite. For PostgreSQL:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/chv

# Leave empty in development: a random key is generated at startup.
# Set a long random value in any deployment.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

MODEL_PATH=app/services/model/model.joblib
MODEL_VERSION=v0.1-lr-uncalibrated

# Provisional referral thresholds; to be set from held-out test results.
LOW_CONFIDENCE=0.50
PROXIMITY_MARGIN=0.10
